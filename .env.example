# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - SISTEMA SISS / SGE
# ==============================================================================

# 1. Frontend SPA (Vite / Supabase)
# Obtenha em: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# 2. Cloudflare Turnstile (Captcha Anti-robô)
VITE_CLOUDFLARE_SITE_KEY=sua-site-key-cloudflare-aqui
CLOUDFLARE_SECRET_KEY=sua-secret-key-cloudflare-aqui

# ==============================================================================
# ATENÇÃO - SEGURANÇA CRÍTICA (NÃO SUBIR CHAVE SERVICE_ROLE PARA O FRONTEND):
# A chave SUPABASE_SERVICE_ROLE_KEY concede acesso total de superusuário e só
# deve ser utilizada em scripts locais de backend/migração (ex: import_to_supabase.js).
# NUNCA a renomeie para VITE_SUPABASE_SERVICE_ROLE_KEY, pois isso a exporia publicamente.
# ==============================================================================
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
SUPABASE_ANON_KEY=sua-anon-key-aqui
PORT=3000
